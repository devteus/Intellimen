<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Services\Background\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="6.0.2" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.15" />
    <PackageReference Include="RestSharp" Version="112.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Intellimen.Repository\Intellimen.Repository.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MessagesExceptions\DefaultExceptions.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DefaultExceptions.resx</DependentUpon>
    </Compile>
  </ItemGroup>

<ItemGroup>
	<Content Update="NLog.config">
		<CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</Content>
</ItemGroup>

<ItemGroup>
  <EmbeddedResource Update="MessagesExceptions\DefaultExceptions.resx">
    <Generator>PublicResXFileCodeGenerator</Generator>
    <LastGenOutput>DefaultExceptions.Designer.cs</LastGenOutput>
  </EmbeddedResource>
</ItemGroup>

</Project>
